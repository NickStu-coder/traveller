# Safe template only. Enter real values into Portainer/environment; never commit them.
COMPOSE_PROJECT_NAME=traveller-prod
TRAVELLER_IMAGE=ghcr.io/nickstu-coder/traveller@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# Use a random URL-safe value; URI-reserved characters require URL encoding.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_PERSISTENT_RANDOM_64_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
APP_URL=https://traveller.flynimbus.synology.me
WEB_PORT=3003
CRON_ENABLED=true
